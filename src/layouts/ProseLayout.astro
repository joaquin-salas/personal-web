---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import PageLayout from "@/layouts/PageLayout.astro";
import { formatDate } from "@/lib/dates";

// Reading page shared by articles and projects. The Markdown body goes in the default slot;
// page-specific details (tags, stack, links) go in the `meta` slot under the dates.

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	cover?: { src: ImageMetadata; alt: string };
}

const { title, description, pubDate, updatedDate, cover } = Astro.props;
---

<PageLayout title={`${title} | Joaquín Salas`} description={description}>
	<article>
		<header class="mb-12 font-display">
			<h1 class="text-4xl leading-[1.05] font-bold tracking-tight text-balance font-stretch-semi-condensed sm:text-5xl">
				{title}
			</h1>
			<p class="mt-4 text-sm text-muted">
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				{updatedDate && (
					<>
						, updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
					</>
				)}
			</p>
			<div class="mt-2 text-sm text-muted">
				<slot name="meta" />
			</div>
			{cover && <Image src={cover.src} alt={cover.alt} class="mt-10 w-full" />}
		</header>

		<div class="prose prose-lg max-w-none prose-albaicin prose-headings:font-display prose-headings:tracking-tight prose-a:underline-offset-4 prose-code:rounded prose-code:bg-rule prose-code:px-1 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-rule">
			<slot />
		</div>
	</article>
</PageLayout>
