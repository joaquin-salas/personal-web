---
import { useTranslations } from "@/i18n/ui";
import { formatDate, getLocale } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getPostUrl } from "@/lib/blog";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const posts = await getPosts(locale);
---

<BaseLayout title={t("blog.title")} description={t("blog.description")}>
	<h1>{t("blog.title")}</h1>

	{posts.length === 0 ? (
		<p>{t("blog.empty")}</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={getPostUrl(post)}>{post.data.title}</a>
					<time datetime={post.data.pubDate.toISOString()}>
						{formatDate(post.data.pubDate, locale)}
					</time>
					{post.data.draft && <span>{t("blog.draft")}</span>}
				</li>
			))}
		</ul>
	)}
</BaseLayout>
