---
import Section from "@/components/Section.astro";
import TagList from "@/components/TagList.astro";
import { education } from "@/data/education";
import { experience } from "@/data/experience";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";
import { useTranslations } from "@/i18n/ui";
import { formatDate, formatYearMonth, getLocale, localizePath } from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getPostUrl } from "@/lib/blog";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const latestPosts = (await getPosts(locale)).slice(0, 3);

const formatPeriodEnd = (end: string) =>
	end === "present" ? t("period.present") : formatYearMonth(end, locale);
---

<BaseLayout
	title={`${profile.name} — ${profile.role[locale]}`}
	description={profile.tagline[locale]}
>
	<section id="hero">
		<h1>{profile.name}</h1>
		<p>
			{profile.role[locale]} · {profile.location[locale]}
		</p>
		<p>{profile.tagline[locale]}</p>
		<ul aria-label={t("home.links")}>
			{profile.links.map((link) => (
				<li>
					<a href={link.href}>{link.label[locale]}</a>
				</li>
			))}
		</ul>
	</section>

	<Section id="about" title={t("home.about")}>
		{profile.about[locale].map((paragraph) => (
			<p>{paragraph}</p>
		))}
	</Section>

	<Section id="experience" title={t("home.experience")}>
		<ol>
			{experience.map((job) => (
				<li>
					<h3>
						{job.role[locale]} ·{" "}
						{job.companyUrl ? <a href={job.companyUrl}>{job.company}</a> : job.company}
					</h3>
					<p>
						{formatYearMonth(job.start, locale)} — {formatPeriodEnd(job.end)}
					</p>
					<p>{job.summary[locale]}</p>
					<ul>
						{job.highlights[locale].map((highlight) => (
							<li>{highlight}</li>
						))}
					</ul>
					<TagList tags={job.stack} label={t("tags.label")} />
				</li>
			))}
		</ol>
	</Section>

	<Section id="projects" title={t("home.projects")}>
		<ul>
			{projects.map((project) => (
				<li>
					<h3>{project.title}</h3>
					<p>{project.description[locale]}</p>
					<TagList tags={project.stack} label={t("tags.label")} />
					{project.repo && <a href={project.repo}>{t("project.code")}</a>}
					{project.demo && <a href={project.demo}>{t("project.demo")}</a>}
				</li>
			))}
		</ul>
	</Section>

	<Section id="education" title={t("home.education")}>
		<ul>
			{education.map((item) => (
				<li>
					<h3>{item.degree[locale]}</h3>
					<p>
						{item.institution[locale]} · {item.location[locale]}
					</p>
					<p>
						{formatYearMonth(item.start, locale)} — {formatPeriodEnd(item.end)}
					</p>
					{item.details && <p>{item.details[locale]}</p>}
				</li>
			))}
		</ul>
	</Section>

	{latestPosts.length > 0 && (
		<Section id="writing" title={t("home.writing")}>
			<ul>
				{latestPosts.map((post) => (
					<li>
						<a href={getPostUrl(post)}>{post.data.title}</a>
						<time datetime={post.data.pubDate.toISOString()}>
							{formatDate(post.data.pubDate, locale)}
						</time>
					</li>
				))}
			</ul>
			<a href={localizePath("/blog/", locale)}>{t("home.allPosts")}</a>
		</Section>
	)}

	<Section id="contact" title={t("home.contact")}>
		<p>{t("home.contactText")}</p>
		<a href={`mailto:${profile.email}`}>{profile.email}</a>
	</Section>
</BaseLayout>
