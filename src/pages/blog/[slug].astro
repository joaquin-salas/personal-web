---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import TagList from "@/components/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/blog";
import { formatDate } from "@/lib/dates";

export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, cover, tags } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description}>
	<article>
		<h1>{title}</h1>
		<p>
			<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
			{updatedDate && (
				<>
					· Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
				</>
			)}
			· {author}
		</p>

		{cover && <Image src={cover.src} alt={cover.alt} />}

		<Content />

		<TagList tags={tags} label="Tags" />
	</article>
</BaseLayout>
