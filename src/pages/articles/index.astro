---
import Command from "@/components/Command.astro";
import Listing from "@/components/Listing.astro";
import TerminalLayout from "@/layouts/TerminalLayout.astro";
import { getFilesystem } from "@/lib/filesystem";
import { nodeAt } from "@/lib/terminal/fs";

const articles = nodeAt(await getFilesystem(), ["articles"]);
---

<TerminalLayout
	title="Articles | Joaquín Salas"
	description="Notes on the technologies Joaquín Salas is learning and using."
	window="articles"
	cwd={["articles"]}
>
	<h1 class="sr-only">Articles</h1>
	<Command cwd="~" command="cd articles" title="Go to the articles folder" />
	<Command cwd="~/articles" command="ls" title="All articles, newest first">
		{articles?.kind === "dir" && <Listing dir={articles} path="~/articles" />}
	</Command>
</TerminalLayout>
