---
import Command from "@/components/Command.astro";
import Neofetch from "@/components/Neofetch.astro";
import { profile } from "@/data/profile";
import TerminalLayout from "@/layouts/TerminalLayout.astro";
import { getFilesystem } from "@/lib/filesystem";
import { nodeAt } from "@/lib/terminal/fs";

// The home page: the terminal boots (first visit of the session) and runs `neofetch`.
const fs = await getFilesystem();
const count = (folder: string) => {
	const node = nodeAt(fs, [folder]);
	return node?.kind === "dir" ? node.children.length : 0;
};
---

<TerminalLayout
	title={`${profile.name}, ${profile.role}`}
	description={profile.tagline}
	window="home"
	cwd={[]}
	boot
>
	<Command cwd="~" command="neofetch" title="Summary" boot>
		<Neofetch projectCount={count("projects")} articleCount={count("articles")} />
	</Command>
</TerminalLayout>
