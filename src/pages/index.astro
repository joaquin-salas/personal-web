---
import Section from "@/components/Section.astro";
import TagList from "@/components/TagList.astro";
import { education } from "@/data/education";
import { experience } from "@/data/experience";
import { profile } from "@/data/profile";
import { projects } from "@/data/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getPostUrl } from "@/lib/blog";
import { formatDate, formatPeriod } from "@/lib/dates";

const latestPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout title={`${profile.name} — ${profile.role}`} description={profile.tagline}>
	<section id="hero">
		<h1>{profile.name}</h1>
		<p>
			{profile.role} · {profile.location}
		</p>
		<p>{profile.tagline}</p>
		<ul aria-label="Links">
			{profile.links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))}
		</ul>
	</section>

	<Section id="about" title="About">
		{profile.about.map((paragraph) => (
			<p>{paragraph}</p>
		))}
	</Section>

	<Section id="experience" title="Experience">
		<ol>
			{experience.map((job) => (
				<li>
					<h3>
						{job.role} · {job.companyUrl ? <a href={job.companyUrl}>{job.company}</a> : job.company}
					</h3>
					<p>{formatPeriod(job.start, job.end)}</p>
					<p>{job.summary}</p>
					<ul>
						{job.highlights.map((highlight) => (
							<li>{highlight}</li>
						))}
					</ul>
					<TagList tags={job.stack} label="Technologies" />
				</li>
			))}
		</ol>
	</Section>

	<Section id="projects" title="Projects">
		<ul>
			{projects.map((project) => (
				<li>
					<h3>{project.title}</h3>
					<p>{project.description}</p>
					<TagList tags={project.stack} label="Technologies" />
					{project.repo && <a href={project.repo}>Code</a>}
					{project.demo && <a href={project.demo}>Live demo</a>}
				</li>
			))}
		</ul>
	</Section>

	<Section id="education" title="Education">
		<ul>
			{education.map((item) => (
				<li>
					<h3>{item.degree}</h3>
					<p>
						{item.institution} · {item.location}
					</p>
					<p>{formatPeriod(item.start, item.end)}</p>
					{item.details && <p>{item.details}</p>}
				</li>
			))}
		</ul>
	</Section>

	{latestPosts.length > 0 && (
		<Section id="writing" title="Latest writing">
			<ul>
				{latestPosts.map((post) => (
					<li>
						<a href={getPostUrl(post)}>{post.data.title}</a>
						<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					</li>
				))}
			</ul>
			<a href="/blog/">All posts →</a>
		</Section>
	)}

	<Section id="contact" title="Contact">
		<p>I'm looking for my first full-time role as a software engineer. Feel free to reach out.</p>
		<a href={`mailto:${profile.email}`}>{profile.email}</a>
	</Section>
</BaseLayout>
