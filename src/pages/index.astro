---
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import TagList from "@/components/TagList.astro";
import { education } from "@/data/education";
import { experience } from "@/data/experience";
import { profile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArticles } from "@/lib/articles";
import { formatPeriod } from "@/lib/dates";
import { getFeaturedProjects } from "@/lib/projects";

const featuredProjects = await getFeaturedProjects();
const latestArticles = (await getArticles()).slice(0, 4);
---

<BaseLayout title={`${profile.name} — ${profile.role}`} description={profile.tagline}>
	<section id="hero">
		<h1>{profile.name}</h1>
		<p>
			{profile.role} · {profile.location}
		</p>
		<p>{profile.tagline}</p>
		<ul aria-label="Links">
			{profile.links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))}
		</ul>
	</section>

	<Section id="about" title="About">
		{profile.about.map((paragraph) => (
			<p>{paragraph}</p>
		))}
	</Section>

	<Section id="experience" title="Experience">
		<ol>
			{experience.map((job) => (
				<li>
					<h3>
						{job.role} · {job.companyUrl ? <a href={job.companyUrl}>{job.company}</a> : job.company}
					</h3>
					<p>{formatPeriod(job.start, job.end)}</p>
					<p>{job.summary}</p>
					<ul>
						{job.highlights.map((highlight) => (
							<li>{highlight}</li>
						))}
					</ul>
					<TagList tags={job.stack} label="Technologies" />
				</li>
			))}
		</ol>
	</Section>

	<Section id="education" title="Education">
		<ul>
			{education.map((item) => (
				<li>
					<h3>{item.degree}</h3>
					<p>
						{item.institution} · {item.location}
					</p>
					<p>{formatPeriod(item.start, item.end)}</p>
					{item.details && <p>{item.details}</p>}
				</li>
			))}
		</ul>
	</Section>

	{featuredProjects.length > 0 && (
		<Section id="projects" title="Projects">
			<ul>
				{featuredProjects.map((project) => (
					<li>
						<ProjectCard project={project} />
					</li>
				))}
			</ul>
			<a href="/projects/">All projects →</a>
		</Section>
	)}

	{latestArticles.length > 0 && (
		<Section id="articles" title="Articles">
			<ul>
				{latestArticles.map((article) => (
					<li>
						<ArticleCard article={article} />
					</li>
				))}
			</ul>
			<a href="/articles/">All articles →</a>
		</Section>
	)}

	<Section id="contact" title="Contact">
		<p>I'm looking for my first full-time role as a software engineer. Feel free to reach out.</p>
		<a href={`mailto:${profile.email}`}>{profile.email}</a>
	</Section>
</BaseLayout>
