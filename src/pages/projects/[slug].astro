---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import TagList from "@/components/TagList.astro";
import ProseLayout from "@/layouts/ProseLayout.astro";
import { getProjects } from "@/lib/projects";

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { stack, repo, demo } = project.data;
const { Content } = await render(project);
---

<ProseLayout {...project.data}>
	<div slot="meta">
		<TagList tags={stack} label="Technologies" />
		{repo && <a href={repo}>Code</a>}
		{demo && <a href={demo}>Live demo</a>}
	</div>
	<Content />
</ProseLayout>
