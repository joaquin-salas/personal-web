---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import ExternalLink from "@/components/ExternalLink.astro";
import TagList from "@/components/TagList.astro";
import ProseLayout from "@/layouts/ProseLayout.astro";
import { getProjects } from "@/lib/projects";

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { stack, repo, demo } = project.data;
const { Content } = await render(project);
---

<ProseLayout {...project.data}>
	<div slot="meta" class="space-y-3">
		<TagList tags={stack} label="Technologies" />
		{(repo || demo) && (
			<p class="flex gap-5 font-medium">
				{repo && (
					<ExternalLink href={repo} class="text-accent underline underline-offset-4">
						View the code
					</ExternalLink>
				)}
				{demo && (
					<ExternalLink href={demo} class="text-accent underline underline-offset-4">
						Open the live demo
					</ExternalLink>
				)}
			</p>
		)}
	</div>
	<Content />
</ProseLayout>
