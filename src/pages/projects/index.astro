---
import Command from "@/components/Command.astro";
import Listing from "@/components/Listing.astro";
import TerminalLayout from "@/layouts/TerminalLayout.astro";
import { getFilesystem } from "@/lib/filesystem";
import { nodeAt } from "@/lib/terminal/fs";

const projects = nodeAt(await getFilesystem(), ["projects"]);
---

<TerminalLayout
	title="Projects | Joaquín Salas"
	description="Projects built by Joaquín Salas and how they were made."
	window="projects"
	cwd={["projects"]}
>
	<h1 class="sr-only">Projects</h1>
	<Command cwd="~" command="cd projects" title="Go to the projects folder" />
	<Command cwd="~/projects" command="ls" title="All projects">
		{projects?.kind === "dir" && <Listing dir={projects} path="~/projects" />}
	</Command>
</TerminalLayout>
