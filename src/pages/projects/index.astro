---
import ProjectCard from "@/components/ProjectCard.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getProjects } from "@/lib/projects";

const projects = await getProjects();
---

<PageLayout
	title="Projects | Joaquín Salas"
	description="Projects built by Joaquín Salas and how they were made."
>
	<h1 class="font-display text-4xl font-bold tracking-tight font-stretch-semi-condensed sm:text-5xl">
		Projects
	</h1>
	<p class="mt-4 max-w-prose text-lg text-muted">Things I've built, and how I built them.</p>

	{projects.length === 0 ? (
		<p class="mt-12">No projects published yet.</p>
	) : (
		<ul class="mt-14 space-y-14">
			{projects.map((project) => (
				<li>
					<ProjectCard project={project} />
				</li>
			))}
		</ul>
	)}
</PageLayout>
