---
// The JS monogram: one line where the J loops into the S, with over/under gaps at the crossings.
// Geometry copied from design/logo/build.mjs (the source of truth); keep them in sync. Uses
// currentColor, so it takes the surrounding text color. Decorative: the name next to it carries
// the meaning.

interface Props {
	/** Size utilities, e.g. `size-6`. */
	class: string;
	/** `regular` at 48px and up; `small` (thicker line) below 48px. */
	cut: "regular" | "small";
}

const { class: className, cut } = Astro.props;

const cuts = {
	regular: { stroke: 3.2, gap: 2.4, clip: 7 },
	small: { stroke: 6.5, gap: 2.4, clip: 9 },
};
const { stroke, gap, clip } = cuts[cut];

const full =
	"M42 16 L42 62 C42 78 24 82 20 70 C17 60 32 56 46 54 C58 52 70 42 74 34 C70 26 58 26 55 34 C52 42 74 48 74 60 C73 72 60 78 50 72";
const loop = "M20 70 C17 60 32 56 46 54 C58 52 70 42 74 34";
const s = "M74 34 C70 26 58 26 55 34 C52 42 74 48 74 60 C73 72 60 78 50 72";
// Where the loop crosses the J stem, and where the S spine crosses the rising line.
const crossings = [
	[42, 55],
	[64, 46],
];

// SVG ids are page-global; prefix them per cut so both cuts can share a page.
const id = (name: string) => `js-${cut}-${name}`;
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
	<defs>
		{crossings.map(([cx, cy], i) => (
			<>
				<clipPath id={id(`cross${i}`)}>
					<circle cx={cx} cy={cy} r={clip} />
				</clipPath>
				<clipPath id={id(`gap${i}`)}>
					<circle cx={cx} cy={cy} r={clip - 1} />
				</clipPath>
			</>
		))}
		<mask id={id("gaps")} maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
			<rect x="-10" y="-10" width="120" height="120" fill="#fff"></rect>
			<g fill="none" stroke="#000" stroke-width={stroke + gap * 2} stroke-linecap="round">
				<path d={loop} clip-path={`url(#${id("gap0")})`}></path>
				<path d={s} clip-path={`url(#${id("gap1")})`}></path>
			</g>
		</mask>
	</defs>
	<g
		transform="translate(3.5 2)"
		fill="none"
		stroke="currentColor"
		stroke-width={stroke}
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d={full} mask={`url(#${id("gaps")})`}></path>
		<path d={loop} clip-path={`url(#${id("cross0")})`}></path>
		<path d={s} clip-path={`url(#${id("cross1")})`}></path>
	</g>
</svg>
