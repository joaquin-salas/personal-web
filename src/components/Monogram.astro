---
// The JS monogram: one brush-pen stroke where the J loops into the S, with over/under gaps at the
// crossings. The shapes come from design/logo/mark.mjs (the source of truth), computed at build
// time. Uses currentColor, so it takes the surrounding text color. Decorative: the name next to it
// carries the meaning.
import { markShapes } from "../../design/logo/mark.mjs";

interface Props {
	/** Size utilities, e.g. `size-6`. */
	class: string;
	/** `regular` at 48px and up; `small` (heavier, less contrast) below 48px. */
	cut: "regular" | "small";
}

const { class: className, cut } = Astro.props;

const { offset, crossings, strokes, halos, over } = markShapes(cut);

// SVG ids are page-global; prefix them per cut so both cuts can share a page.
const id = (name: string) => `js-${cut}-${name}`;
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
	<defs>
		{crossings.map(({ cx, cy, clip, gap }, i) => (
			<>
				<clipPath id={id(`cross${i}`)}>
					<circle cx={cx} cy={cy} r={clip} />
				</clipPath>
				<clipPath id={id(`gap${i}`)}>
					<circle cx={cx} cy={cy} r={gap} />
				</clipPath>
			</>
		))}
		<mask id={id("gaps")} maskUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
			<rect x="-10" y="-10" width="120" height="120" fill="#fff"></rect>
			{halos.map((d, i) => (
				<path d={d} fill="#000" clip-path={`url(#${id(`gap${i}`)})`}></path>
			))}
		</mask>
	</defs>
	<g transform={offset} fill="currentColor">
		<g mask={`url(#${id("gaps")})`}>
			{strokes.map((d) => (
				<path d={d}></path>
			))}
		</g>
		{over.map((d, i) => (
			<path d={d} clip-path={`url(#${id(`cross${i}`)})`}></path>
		))}
	</g>
</svg>
