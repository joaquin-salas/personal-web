---
// Renders as plain comma-separated text ("React, Node.js, Koa") rather than chips.

interface Props {
	tags: string[];
	label: string;
}

const { tags, label } = Astro.props;
---

{tags.length > 0 && (
	<ul aria-label={label} class="flex flex-wrap font-display text-sm text-muted">
		{tags.map((tag) => (
			<li class="after:mr-1.5 after:content-[','] last:after:content-none">{tag}</li>
		))}
	</ul>
)}
