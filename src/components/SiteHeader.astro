---
import StarMark from "@/components/StarMark.astro";

// Top bar for every page except the home page, which has its own sticky header.

interface Props {}

const pages = [
	{ href: "/projects/", label: "Projects" },
	{ href: "/articles/", label: "Articles" },
];
const current = Astro.url.pathname;
---

<header class="flex items-center justify-between gap-6 py-8 font-display">
	<a href="/" class="flex items-center gap-2 font-semibold hover:text-accent">
		<StarMark class="size-5" />
		Joaquín Salas
	</a>
	<nav aria-label="Main">
		<ul class="flex gap-5 text-sm">
			{pages.map(({ href, label }) => (
				<li>
					<a
						href={href}
						aria-current={current.startsWith(href) ? "page" : undefined}
						class="text-muted hover:text-ink aria-[current]:text-ink aria-[current]:underline aria-[current]:underline-offset-4"
					>
						{label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>
