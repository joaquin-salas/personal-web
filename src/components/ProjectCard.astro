---
import TagList from "@/components/TagList.astro";
import { getProjectUrl, type Project } from "@/lib/projects";

// Row in a project list. Deliberately not a boxed card: spacing separates projects.

interface Props {
	project: Project;
}

const { project } = Astro.props;
const { title, description, stack, draft } = project.data;
---

<article>
	<h3 class="font-display text-xl leading-snug font-semibold">
		<a href={getProjectUrl(project)} class="hover:text-accent hover:underline underline-offset-4">
			{title}
		</a>
		{draft && <span class="ml-2 text-sm font-normal text-muted italic">Draft</span>}
	</h3>
	<p class="mt-2">{description}</p>
	<div class="mt-3">
		<TagList tags={stack} label="Technologies" />
	</div>
</article>
