---
// Switches between light and dark and remembers the choice. Until someone uses it, the theme
// follows the OS (see BaseLayout's head script). Hidden without JavaScript, where it can't work.

interface Props {}
---

<button
	type="button"
	data-theme-toggle
	aria-label="Dark mode"
	aria-pressed="false"
	class="-m-1 cursor-pointer p-1 text-muted hover:text-ink [:root:not([data-theme])_&]:hidden"
>
	<!-- Moon in light mode, sun in dark mode: line icons, round caps like the monogram. -->
	<svg
		class="size-4 dark:hidden"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
	</svg>
	<svg
		class="hidden size-4 dark:block"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.75"
		stroke-linecap="round"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

	function sync() {
		const dark = root.dataset.theme === "dark";
		for (const button of buttons) button.setAttribute("aria-pressed", String(dark));
	}

	function storedTheme(): string | null {
		try {
			return localStorage.getItem("theme");
		} catch {
			return null; // Storage blocked: the toggle still works for this page view.
		}
	}

	for (const button of buttons) {
		button.addEventListener("click", () => {
			const next = root.dataset.theme === "dark" ? "light" : "dark";
			root.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch {}
			sync();
		});
	}

	// Follow OS changes live, unless the visitor has picked a theme.
	matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
		if (storedTheme()) return;
		root.dataset.theme = event.matches ? "dark" : "light";
		sync();
	});

	sync();
</script>
