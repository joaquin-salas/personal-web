---
import { getArticleUrl, type Article } from "@/lib/articles";
import { formatDate } from "@/lib/dates";

// Row in an article list: publication date in a column (same width as the experience timeline's
// dates, so they line up on the home page), then title and description.

interface Props {
	article: Article;
}

const { article } = Astro.props;
const { title, description, pubDate, draft } = article.data;
---

<article class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-8">
	<time datetime={pubDate.toISOString()} class="font-display text-sm text-muted sm:pt-1">
		{formatDate(pubDate)}
	</time>
	<div>
		<h3 class="font-display text-lg leading-snug font-semibold">
			<a href={getArticleUrl(article)} class="hover:text-accent hover:underline underline-offset-4">
				{title}
			</a>
			{draft && <span class="ml-2 text-sm font-normal text-mark">Draft</span>}
		</h3>
		<p class="mt-1 text-muted">{description}</p>
	</div>
</article>
