---
// Link to another site: opens in a new tab. `noopener` stops the new page from controlling this
// one; the hidden text tells screen reader users that a new tab will open.

interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
// Prettier puts link text on its own lines; trimmed, so underlines don't run into the spaces.
const content = (await Astro.slots.render("default")).trim();
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className}>
	<Fragment set:html={content} />
	<span class="sr-only"> (opens in a new tab)</span>
</a>
